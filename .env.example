# ============================================
# EduAvatar - Variables d'environnement (racine)
# Copiez ce fichier en .env à la racine du projet
# pour configurer Docker Compose et les services IA
# ============================================

# === POSTGRESQL ===
POSTGRES_USER=eduvatar
POSTGRES_PASSWORD=eduvatar123
POSTGRES_DB=eduvatar

# === JWT ===
# IMPORTANT : changez cette clé en production
JWT_SECRET=changez-moi-cette-cle-secrete-avec-une-longue-chaine

# === SERVICES IA (gratuits) ===

# GROQ API (LLM pour les réponses intelligentes)
# Obtenez une clé gratuite : https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# HUGGING FACE (Whisper pour la reconnaissance vocale)
# Obtenez une clé gratuite : https://huggingface.co/settings/tokens
HF_API_KEY=
HF_WHISPER_MODEL=openai/whisper-large-v3

# EDGE TTS (synthèse vocale - GRATUIT, pas de clé nécessaire)
EDGE_TTS_VOICE=fr-FR-DeniseNeural

# SADTALKER via Colab + ngrok (génération d'avatar parlant)
# Mettez ici l'URL ngrok exposée par le notebook Colab
SADTALKER_API_URL=

# === CORS ===
# URL du frontend pour autoriser les requêtes croisées
CORS_ORIGIN=http://localhost:4200
