# ============================================
# EduAvatar Backend - Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# ============================================

# === SERVER ===
PORT=3000
NODE_ENV=development

# === DATABASE (PostgreSQL) ===
DB_HOST=db
DB_PORT=5432
DB_USER=eduvatar
DB_PASSWORD=eduvatar123
DB_NAME=eduvatar

# === AUTHENTIFICATION JWT ===
JWT_SECRET=changez-moi-par-une-cle-secrete-tres-longue
JWT_EXPIRES_IN=7d

# === LLM (GROQ API - gratuite) ===
# Obtenez une clé sur https://console.groq.com
GROQ_API_KEY=votre-cle-groq-ici
GROQ_MODEL=openai/gpt-oss-120b

# === RECONNAISSANCE VOCALE (Hugging Face Whisper) ===
# Obtenez une clé sur https://huggingface.co/settings/tokens
HF_API_KEY=votre-cle-huggingface-ici
HF_WHISPER_MODEL=openai/whisper-large-v3

# === SYNTHESE VOCALE (Edge TTS) ===
# Edge TTS est gratuit et ne nécessite PAS de clé API
EDGE_TTS_VOICE=fr-FR-DeniseNeural

# === AVATAR PARLANT (SadTalker via Colab + ngrok) ===
# L'URL ngrok exposée par le notebook Colab
SADTALKER_API_URL=http://localhost:4040

# === CORS ===
# Origin autorisé pour le frontend Angular
CORS_ORIGIN=http://localhost:4200
